% =====================================================================
% P1. Lógica en la BDD
% =====================================================================
\section*{P1. Lógica en la BDD}

% =====================================================================
% P1.1 — Stored Procedure
% =====================================================================
\begin{querybox}{P1.1 --- Stored Procedure: precio vigente por fecha y categoría}

El procedimiento recibe una \textbf{fecha} y un \textbf{id\_cate}.
Retorna el precio vigente de todos los productos activos en esa categoría
para la fecha indicada.
Si el producto pertenece a una lista de oferta vigente (\texttt{tipo=1}),
se usa ese precio; de lo contrario se usa el precio base (\texttt{tipo=0}).

\vspace{0.4cm}

\begin{sqlbox}{PostgreSQL --- obtener\_precios\_vigentes(p\_fecha, p\_id\_cate)}
\begin{lstlisting}[style=sqlstyle]
CREATE OR REPLACE FUNCTION obtener_precios_vigentes(
    p_fecha   DATE,
    p_id_cate INT
)
RETURNS TABLE (
    id_prod      INT,
    nombre_prod  VARCHAR,
    precio       INT,
    tipo_precio  TEXT
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    WITH oferta AS (
        -- Productos con lista de OFERTA vigente en la fecha dada
        SELECT pl.id_prod, pl.precio
        FROM   Producto_Lista pl
        JOIN   Lista_Precios  lp ON pl.id_lista = lp.id_lista
        WHERE  lp.tipo = 1
          AND  p_fecha BETWEEN lp.inicio_vigencia AND lp.fin_vigencia
    ),
    base AS (
        -- Precio BASE vigente para cada producto
        SELECT pl.id_prod, pl.precio
        FROM   Producto_Lista pl
        JOIN   Lista_Precios  lp ON pl.id_lista = lp.id_lista
        WHERE  lp.tipo = 0
          AND  p_fecha BETWEEN lp.inicio_vigencia AND lp.fin_vigencia
    )
    SELECT
        p.id_prod,
        p.nombre_prod,
        COALESCE(o.precio, b.precio)                         AS precio,
        CASE WHEN o.precio IS NOT NULL THEN 'oferta'
             ELSE 'base' END                                 AS tipo_precio
    FROM   Producto p
    LEFT JOIN oferta o ON p.id_prod = o.id_prod
    LEFT JOIN base   b ON p.id_prod = b.id_prod
    WHERE  p.activo   = TRUE
      AND  p.id_cate  = p_id_cate
      AND  COALESCE(o.precio, b.precio) IS NOT NULL;
END;
$$;

-- Ejemplo de uso
SELECT * FROM obtener_precios_vigentes('2026-05-15', 1);
\end{lstlisting}
\end{sqlbox}

\vspace{0.3cm}
\textbf{Lógica principal:}
\begin{itemize}[leftmargin=1.5em]
  \item Se calculan dos CTE: \texttt{oferta} (listas con \texttt{tipo=1} vigentes)
        y \texttt{base} (listas con \texttt{tipo=0} vigentes).
  \item Se usa \texttt{COALESCE(o.precio, b.precio)} para priorizar el precio
        de oferta sobre el base.
  \item Solo se retornan productos activos de la categoría solicitada que
        tengan al menos un precio en una lista vigente.
\end{itemize}

\end{querybox}

\vspace{0.6cm}

% =====================================================================
% P1.2 — Trigger
% =====================================================================
\begin{querybox}{P1.2 --- Trigger: crear tabla \texttt{Productos\_Sin\_Precio\_YYYYMMDD}}

Al insertar un registro en \texttt{Lista\_Precios}, se crea la tabla
\texttt{Productos\_Sin\_Precio\_YYYYMMDD} (con la fecha actual) y se insertan
todos los productos \textbf{activos} que \textbf{no} pertenecen a ninguna
lista de oferta (\texttt{tipo = 1}).

La tabla creada contiene: \texttt{id\_prod}, \texttt{sku},
\texttt{nombre\_prod}, \texttt{id\_cate}.

\vspace{0.4cm}

\begin{sqlbox}{PostgreSQL --- Función + Trigger}
\begin{lstlisting}[style=sqlstyle]
CREATE OR REPLACE FUNCTION fn_productos_sin_precio()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
    v_tabla TEXT;
BEGIN
    -- Nombre dinamico con fecha de hoy
    v_tabla := 'Productos_Sin_Precio_'
               || TO_CHAR(CURRENT_DATE, 'YYYYMMDD');

    -- Crear la tabla si aun no existe
    EXECUTE format('
        CREATE TABLE IF NOT EXISTS %I (
            id_prod     INT,
            sku         VARCHAR(50),
            nombre_prod VARCHAR(100),
            id_cate     INT
        )', v_tabla);

    -- Insertar productos activos que NO estan en ninguna oferta
    EXECUTE format('
        INSERT INTO %I (id_prod, sku, nombre_prod, id_cate)
        SELECT p.id_prod, p.sku, p.nombre_prod, p.id_cate
        FROM   Producto p
        WHERE  p.activo = TRUE
          AND  p.id_prod NOT IN (
                   SELECT pl.id_prod
                   FROM   Producto_Lista pl
                   JOIN   Lista_Precios  lp
                          ON pl.id_lista = lp.id_lista
                   WHERE  lp.tipo = 1
               )', v_tabla);

    RETURN NEW;
END;
$$;

-- Asociar el trigger a la tabla Lista_Precios
CREATE TRIGGER trg_lista_precios_insert
AFTER INSERT ON Lista_Precios
FOR EACH ROW
EXECUTE FUNCTION fn_productos_sin_precio();
\end{lstlisting}
\end{sqlbox}

\vspace{0.3cm}
\textbf{Decisiones de diseño:}
\begin{itemize}[leftmargin=1.5em]
  \item Se usa \texttt{CREATE TABLE IF NOT EXISTS} para tolerar múltiples
        inserciones en el mismo día sin error.
  \item \texttt{format(\ldots, v\_tabla)} con \texttt{\%I} previene inyección SQL
        al citar el nombre de tabla dinámicamente.
  \item El trigger es \texttt{AFTER INSERT} para que el nuevo registro en
        \texttt{Lista\_Precios} ya esté disponible al momento de evaluar
        la condición de oferta.
\end{itemize}

\end{querybox}

\newpage

% =====================================================================
% P3. Formas Normales
% =====================================================================
\section*{P3. Formas Normales}

Relación analizada:
\[
  \textbf{Libros}(\underline{ISBN},\; Titulo,\; AutorID,\;
  NombreAutor,\; CiudadAutor)
\]

% =====================================================================
% P3.1
% =====================================================================
\begin{querybox}{P3.1 --- Dependencias Funcionales}

A partir de las restricciones del enunciado (ISBN es PK, cada autor tiene
un único nombre y vive en una única ciudad), se identifican las siguientes
dependencias funcionales:

\vspace{0.3cm}
\begin{center}
\begin{tabular}{cl p{7cm}}
  \hline
  \textbf{\#} & \textbf{Dependencia} & \textbf{Justificación} \\
  \hline
  1 & $ISBN \to Titulo$      & Cada ISBN identifica un único título. \\
  2 & $ISBN \to AutorID$     & Cada libro tiene un único autor. \\
  3 & $AutorID \to NombreAutor$ & Cada autor tiene un único nombre. \\
  4 & $AutorID \to CiudadAutor$ & Cada autor vive en una única ciudad. \\
  5 & $ISBN \to NombreAutor$ & Transitiva: $ISBN \to AutorID \to NombreAutor$. \\
  6 & $ISBN \to CiudadAutor$ & Transitiva: $ISBN \to AutorID \to CiudadAutor$. \\
  \hline
\end{tabular}
\end{center}

\vspace{0.2cm}
\footnotesize\textbf{Nota:} No existe la DF $NombreAutor \to CiudadAutor$ porque
dos autores distintos podrían compartir nombre pero vivir en ciudades distintas;
la dependencia se ancla en \texttt{AutorID}.

\end{querybox}

\vspace{0.6cm}

% =====================================================================
% P3.2
% =====================================================================
\begin{querybox}{P3.2 --- ¿Está en Tercera Forma Normal (3NF)?}

\textbf{No}, la relación \textbf{no está en 3NF}.

Para cumplir con 3NF, toda dependencia funcional no trivial $X \to A$ debe
satisfacer al menos una de estas condiciones:
\begin{enumerate}[label=(\arabic*),leftmargin=2em]
  \item $X$ es superclave de la relación, \textbf{o}
  \item $A$ es un atributo primo (pertenece a alguna llave candidata).
\end{enumerate}

\vspace{0.3cm}
La única llave candidata es $\{ISBN\}$, por lo que los únicos atributos primos
son $\{ISBN\}$. Los demás atributos son \textbf{no-primos}.

\vspace{0.3cm}
Las dependencias problemáticas son:
\[
  AutorID \;\to\; NombreAutor
  \qquad\text{y}\qquad
  AutorID \;\to\; CiudadAutor
\]

En ambas: $AutorID$ \textbf{no es superclave} y $NombreAutor$, $CiudadAutor$
\textbf{no son atributos primos}. Son dependencias \textbf{transitivas}
($ISBN \to AutorID \to \{NombreAutor, CiudadAutor\}$), lo que viola la 3NF.

\end{querybox}

\vspace{0.6cm}

% =====================================================================
% P3.3
% =====================================================================
\begin{querybox}{P3.3 --- Descomposición en 3NF y BCNF}

Para eliminar las dependencias transitivas descomponemos en dos relaciones:

\vspace{0.3cm}

\begin{answerbox}
\begin{align*}
  \textbf{Libros}&(\underline{ISBN},\; Titulo,\; AutorID)
    &&\text{FK: } AutorID \to Autores\\[4pt]
  \textbf{Autores}&(\underline{AutorID},\; NombreAutor,\; CiudadAutor)
\end{align*}
\end{answerbox}

\vspace{0.4cm}
\textbf{¿Por qué cumple 3NF y BCNF?}

\begin{center}
\begin{tabular}{lll}
  \hline
  \textbf{Tabla} & \textbf{DFs no triviales} & \textbf{¿Cumple BCNF?} \\
  \hline
  \textbf{Libros}  & $ISBN \to \{Titulo, AutorID\}$                 &
    \checkmark\ $ISBN$ es superclave \\
  \textbf{Autores} & $AutorID \to \{NombreAutor, CiudadAutor\}$     &
    \checkmark\ $AutorID$ es superclave \\
  \hline
\end{tabular}
\end{center}

\vspace{0.3cm}
En BCNF el determinante de toda DF no trivial debe ser superclave. Ambas
tablas lo cumplen, por lo que la descomposición satisface tanto
\textbf{3NF} como \textbf{BCNF}.

\vspace{0.4cm}
\textbf{Propiedades adicionales:}
\begin{itemize}[leftmargin=1.5em]
  \item \textbf{Lossless-join:} el atributo común $AutorID$ es llave primaria
        en \texttt{Autores}, por lo que el JOIN recupera exactamente la
        relación original sin tuplas espurias.
  \item \textbf{Dependency-preserving:} las DFs $(1)$--$(4)$ del punto 3.1
        quedan preservadas en las tablas resultantes ($1$--$2$ en
        \texttt{Libros}; $3$--$4$ en \texttt{Autores}).
\end{itemize}

\end{querybox}

\end{document}
