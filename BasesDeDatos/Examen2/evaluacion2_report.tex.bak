\section*{Esquema de la Base de Datos}

\begin{schemabox}
\begin{align*}
  \textbf{Categoria}&(\underline{id\_cate},\;
    nombre\_cate,\; descripcion\_cate,\; activo)\\[4pt]
  \textbf{Producto}&(\underline{id\_prod},\;
    sku,\; nombre\_prod,\; descripcion\_prod,\;
    \textit{id\_cate},\; activo)\\[4pt]
  \textbf{Lista\_Precios}&(\underline{id\_lista},\;
    inicio\_vigencia,\; fin\_vigencia,\; tipo)\\[4pt]
  \textbf{Producto\_Lista}&(\underline{\textit{id\_prod}},\;
    \underline{\textit{id\_lista}},\; precio)
\end{align*}
\smallskip
\footnotesize
\textbf{Nota:} Llaves primarias \underline{subrayadas}. Llaves foráneas en
\textit{itálica}.
\texttt{Producto.id\_cate} $\to$ \texttt{Categoria.id\_cate};\quad
\texttt{Producto\_Lista.id\_prod} $\to$ \texttt{Producto.id\_prod};\quad
\texttt{Producto\_Lista.id\_lista} $\to$ \texttt{Lista\_Precios.id\_lista}.
\end{schemabox}

